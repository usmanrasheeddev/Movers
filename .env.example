# Supabase (optional; admin panel only)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: Google Places Autocomplete (premium address suggestions)
VITE_GOOGLE_PLACES_API_KEY=

# Optional: Hero background video (avoids default 404s)
VITE_HERO_VIDEO_SRC=
VITE_HERO_VIDEO_POSTER=

# Auth0 (required for booking login)
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
# Optional: Auth0 API audience
VITE_AUTH0_AUDIENCE=

# Booking email (Vercel Serverless Function)
# These are NOT VITE_ vars and should be set in Vercel Environment Variables.
RESEND_API_KEY=
BOOKING_EMAIL_TO=
BOOKING_EMAIL_FROM=

